'<td class="px-2 py-2">'+rk+' <span class="text-white text-[.8rem] font-semibold">'+cDisplay+'</span></td>'+
'<td class="px-2 py-2 text-center font-display font-bold text-white text-sm num">'+fN(d.cal,1)+'</td>'+
'<td class="px-2 py-2 text-center text-yellow-400 font-display font-bold text-sm num">'+st.mvp+'</td>'+
'<td class="px-2 py-2 text-center text-cap1 font-display font-bold text-sm num">'+st.v+'</td>'+
'<td class="px-2 py-2 text-center text-accent font-display font-bold text-sm num">'+st.e+'</td>'+
'<td class="px-2 py-2 text-center text-red-400 font-display font-bold text-sm num">'+st.d+'</td>'+
