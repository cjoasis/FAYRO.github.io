}

function renderRankingBody(){
var tb=document.getElementById('tb-rank');
if(!rankingDatos.length){tb.innerHTML='<tr><td colspan="9" class="px-3 py-8 text-center text-muted text-sm">Sin datos</td></tr>';return}

var col=sortEstado.col;
var dir=sortEstado.dir==='desc'?-1:1;

var ordenados=rankingDatos.slice().sort(function(a,b){
var va,VB;
if(col==='nombre'){va=a.nLimpio.toLowerCase();VB=b.nLimpio.toLowerCase();return dir*va.localeCompare(VB)}
va=a[col];VB=b[col];
if(typeof va==='string')return dir*va.localeCompare(VB);
return dir*(va-VB);
});

tb.innerHTML=ordenados.map(function(d,i){
var st=d.st;var pf=d.pf;var ewr=d.ewr;
