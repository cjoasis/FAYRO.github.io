function nLimpio(n){if(!n)return '';return n.replace(/\s*\(\d+(?:\.\d+)?\)\s*$/,'').trim()}
function calJ(nombre){var j=D.jugadores.find(function(x){return x.nombre===nombre});if(j)return j.calificacion||1;var lim=nLimpio(nombre);j=D.jugadores.find(function(x){return nLimpio(x.nombre)===lim});return j?(j.calificacion||1):1}
function fN(n,d){if(n==null||isNaN(n))return d!=null?(0).toFixed(d):'0.0';return Number(n).toFixed(d!=null?d:1)}
function resJug(partido,nJug,nCap1){var alis=partido.partido_alineaciones||[];var esta=alis.find(function(a){return a.jugador_nombre===nJug});if(!esta)return null;var eq1=alis.find(function(a){return a.jugador_nombre===nJug&&a.equipo_del_capitan_nombre===nCap1});var r=partido.resultado;if(!eq1){if(r==='ganador_cap2')return 'V';if(r==='ganador_cap1')return 'D';return 'E'}else{if(r==='ganador_cap1')return 'V';if(r==='ganador_cap2')return 'D';return 'E'}}
function ptsRes(r){if(r==='V')return 1;if(r==='E')return 0.33;if(r==='D')return -1;return 0}
function calcEWR(v,e,d){var t=v+e+d;if(t===0)return 0;return ((v+e/3)/t)*100}
function calcPF(mvp,cal,v,e,pj){if(pj===0)return cal;return (mvp*0.1)+cal+((v+(e*0.333))/pj)+(pj/50)}
function anioP(m){if(m['año']!=null)return m['año'];if(m['anio']!=null)return m['anio'];return ''}

